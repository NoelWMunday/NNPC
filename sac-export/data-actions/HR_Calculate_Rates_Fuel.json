 "steps": [
  {
   "id": "35145914-8973-4607-3520-763223376355",
   "name": "Calculate_Fuel",
   "description": "",
   "stepType": "SCRIPT",
   "panelType": "TEXTUAL",
   "scriptContent": "CONFIG.HIERARCHY = [d/Ln].[h/SCH]\nCONFIG.TIME_HIERARCHY = CALENDARYEAR\nCONFIG.FLIPPING_SIGN_ACCORDING_ACCTYPE = OFF\nCONFIG.GENERATE_UNBOOKED_DATA = ON\n\nMEMBERSET [d/PPP_Entity] = (BASEMEMBER([d/PPP_Entity].[h/H1], %EntitySelection%))\nMEMBERSET [d/Date] = BASEMEMBER([d/Date] , %CY_plus_1%)\nMEMBERSET [d/Grade] = (BASEMEMBER([d/Grade].[h/H1], %GradeSelection%))\nMEMBERSET [d/PPP_Currency] = (\"NGN\")\nMEMBERSET [d/Ln] = (\"MB_025\")\nMEMBERSET [d/PCycle] = \"HR\"\nMEMBERSET [d/CostElement] = (\"#\")\nMEMBERSET [d/Lock] = (\"#\")\nMEMBERSET [d/GL] = (\"#\")\n\n\nDATA([d/Measures] = \"Rates\") = \n\tRESULTLOOKUP([d/Measures] = \"Qty\", [d/PPP_Currency] = \"#\") * \n\tRESULTLOOKUP([d/Measures] = \"Price\") * \n\tRESULTLOOKUP([d/Measures] = \"Weeks\", [d/PPP_Currency] = \"#\") * \n\tRESULTLOOKUP([d/Measures] = \"NoCars\", [d/PPP_Currency] = \"#\") \n",
   "memberFilter": {},
   "isVisualPanel": false,
   "scriptReferences": {
    "referenceCubes": [],
    "usedParameters": [
     "EntitySelection",
     "CY_plus_1",
     "GradeSelection"
    ]
   },
   "isConvertedOnce": false,
   "isTextScriptChanged": true
  },
  {
