  {
   "id": "93597542-2134-4589-3920-643881078878",
   "name": "YTD Calc",
   "description": "Year-To-Date",
   "stepType": "SCRIPT",
   "panelType": "TEXTUAL",
   "scriptContent": "CONFIG.TIME_HIERARCHY = CALENDARYEAR\nCONFIG.FLIPPING_SIGN_ACCORDING_ACCTYPE = OFF\nCONFIG.GENERATE_UNBOOKED_DATA = ON\n\nMEMBERSET [d/Measures] = (\"PC_YTD\", \"PC_FUSD\")\nMEMBERSET [d/Plan_Cycle] = %PCycle%\nMEMBERSET [d/PPP_Entity] = BASEMEMBER([d/PPP_Entity], %Entity%)\nMEMBERSET [d/Lock] = \"#\"\n\nFOREACH [d/Date].[p/YEAR]\n\n\tDATA.APPEND(\n\t\t\t\t[d/Measures] = \"PC_YTD\",\n\t\t\t\t[d/Date] = LAST([d/Date]),\n\t\t\t\t[d/PPP_Currency] = \"USD\"\n\t\t\t   ) =\n\tRESULTLOOKUP(\n\t\t\t\t [d/Measures] = \"PC_FUSD\"\n\t\t\t\t)\n\nENDFOR",
   "memberFilter": {},
