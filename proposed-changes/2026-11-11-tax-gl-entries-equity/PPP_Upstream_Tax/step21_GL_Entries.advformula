	RESULTLOOKUP([d/Measures] = "Value_WPLn", [d/WPLn] = "TAX015_05", [d/GL] = "#", [d/PPP_EntryNr] = "#", [d/PPP_Currency] = "#") *
	RESULTLOOKUP([d/Measures] = "Value_WPLn", [d/WPLn] = "AMT_90", [d/GL] = "#", [d/PPP_EntryNr] = "#", [d/PPP_Currency] = "#") / 100

