 "steps": [
  {
   "id": "23804583-9032-4442-3003-218364454127",
   "name": "Fill Forecast Periods and apply escallation",
   "description": "First planning year (CY+1)",
   "stepType": "SCRIPT",
   "panelType": "TEXTUAL",
   "scriptContent": "MEMBERSET [d/PCycle] = \"HR\" \nMEMBERSET [d/Date] = BASEMEMBER([d/Date],%CurrentYear%)\nMEMBERSET [d/PPP_Entity] = \"N01_HCM\"\nMEMBERSET [d/Grade] = (BASEMEMBER([d/Grade].[h/H1], %ParameterGrade%))\nMEMBERSET [d/Measures] = (%ParameterMeasureSelection%)\nMEMBERSET [d/CostElement] = (BASEMEMBER([d/CostElement].[h/CalcInputH], %ParameterCostElement%))\nMEMBERSET [d/PPP_Currency] = (%ParameterCurrency%)\nMEMBERSET [d/GL] = (\"#\")\nMEMBERSET [d/Lock] = (\"#\")\nMEMBERSET [d/Ln] = (BASEMEMBER([d/Ln].[h/H1], %Parameter%))\n\nDATA() = RESULTLOOKUP([d/Date] = \"000000\" /*!  Parameter  */)\n\n",
   "memberFilter": {},
   "isVisualPanel": false,
   "scriptReferences": {
    "referenceCubes": [],
    "usedParameters": [
     "CurrentYear",
     "ParameterGrade",
     "ParameterMeasureSelection",
     "ParameterCostElement",
     "ParameterCurrency",
     "Parameter"
    ]
   },
   "isConvertedOnce": false,
   "isTextScriptChanged": true
  },
  {
   "id": "41304860-4037-4772-3764-038835281191",
   "name": "Fill Forecast Periods and apply escallation",
   "description": "Years after CY+1",
   "stepType": "SCRIPT",
   "panelType": "TEXTUAL",
   "scriptContent": "// Current year that is passed as a variable is actually CY+1\n\nMEMBERSET [d/PCycle] = \"HR\" \nMEMBERSET [d/PPP_Entity] = \"N01_HCM\"\nMEMBERSET [d/Grade] = (BASEMEMBER([d/Grade].[h/H1], %ParameterGrade%))\nMEMBERSET [d/Measures] = (%ParameterMeasureSelection%)\nMEMBERSET [d/CostElement] = (BASEMEMBER([d/CostElement].[h/CalcInputH], %ParameterCostElement%))\nMEMBERSET [d/PPP_Currency] = (%ParameterCurrency%)\nMEMBERSET [d/GL] = (\"#\")\nMEMBERSET [d/Lock] = (\"#\")\nMEMBERSET [d/Ln] = (BASEMEMBER([d/Ln].[h/H1], %Parameter%))\n\nINTEGER @ForecastYearStartCount = 0\n\nFOREACH [d/Date].[p/YEAR] ASC\n\n\tIF [d/Date] = BASEMEMBER([d/Date] , %CurrentYear%) THEN\n\n\t\t@ForecastYearStartCount = 2\n\n\tELSEIF @ForecastYearStartCount > 1 AND @ForecastYearStartCount < 7 THEN\n\t\t\tIF [d/Date].[p/MONTHDESC] = \"Dec\" THEN\n\t\t\t\t\n\t\t\t\t@ForecastYearStartCount = @ForecastYearStartCount + 1\n\t\t\t\t\n\t\t\t\t//Forecast Years\n\t\t\t\tDATA() = RESULTLOOKUP([d/Date] = PREYEARLAST()) * (1 + (\n\t\t\t\tRESULTLOOKUP([d/Ln] = %EscallationParam%, [d/Date] = \"000000\", [d/Measures] = \"Qty\", [d/PPP_Currency] = \"#\", [d/CostElement] = \"#\", [d/GL] = \"#\", [d/Grade] = \"#\" /*! Escallation Parameter */) / 100\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   )\n\t\t\tENDIF\n\tENDIF\nENDFOR",
   "memberFilter": {},
   "isVisualPanel": false,
   "scriptReferences": {
    "referenceCubes": [],
    "usedParameters": [
     "ParameterGrade",
     "ParameterMeasureSelection",
     "ParameterCostElement",
     "ParameterCurrency",
     "Parameter",
     "CurrentYear",
     "EscallationParam"
    ]
   },
   "isConvertedOnce": false,
   "isTextScriptChanged": true
  }
 ]
