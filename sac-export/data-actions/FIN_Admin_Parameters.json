  {
   "id": "20243803-0529-4978-3856-932676375832",
   "name": "Step 02",
   "description": "Copy expense limit parameter to entity from central settings",
   "stepType": "SCRIPT",
   "panelType": "TEXTUAL",
   "scriptContent": "CONFIG.TIME_HIERARCHY = CALENDARYEAR\nCONFIG.FLIPPING_SIGN_ACCORDING_ACCTYPE = OFF\nCONFIG.GENERATE_UNBOOKED_DATA = ON\n\nMEMBERSET [d/PPP_Account] = (\"FIN06_Check_limit_OH\", \"FIN06_Check_limit_Moveables\",\"FIN06_Check_limit_Capex\")\nMEMBERSET [d/PPP_Entity] = BASEMEMBER([d/PPP_Entity] , %Entity%)\nMEMBERSET [d/PCycle] = \"#\"\nMEMBERSET [d/PPP_Currency] = (\"#\",\"USD\")\nMEMBERSET [d/PPP_EntryNr] = (\"#\",\"1001\")\nMEMBERSET [d/Date].[p/MONTHDESC] = \"Dec\"\nMEMBERSET [d/Measures] = (\"RPT_YOY\",\"RPT_METRCS\")\n\nDATA([d/Measures]=\"RPT_YOY\",[d/PPP_Currency]=\"USD\",[d/PPP_EntryNr]=\"1001\") = \n\tROUND(RESULTLOOKUP([d/Measures]=\"RPT_METRCS\",[d/PPP_Entity] = \"#\",[d/PPP_EntryNr]=\"#\",[d/PPP_Currency]=\"#\") / 100, 2)\n\n",
   "memberFilter": {},
   "isVisualPanel": false,
   "scriptReferences": {
    "referenceCubes": [],
    "usedParameters": [
     "Entity"
    ]
   },
   "isConvertedOnce": false,
   "isTextScriptChanged": true
  },
  {
   "id": "14492542-3442-4671-3034-870474644540",
   "name": "Step 03",
   "description": "Delete assumptions prior to CY+1",
   "stepType": "SCRIPT",
   "panelType": "TEXTUAL",
   "scriptContent": "// Deleting these periods ensures no calculation is performed for them in the next step\n\nCONFIG.TIME_HIERARCHY = CALENDARYEAR\nCONFIG.FLIPPING_SIGN_ACCORDING_ACCTYPE = OFF\nCONFIG.GENERATE_UNBOOKED_DATA = ON\n\nMEMBERSET [d/PPP_Account] = (\"FIN06_02_01\",\"FIN06_02_02\")\nMEMBERSET [d/PPP_Entity] = BASEMEMBER([d/PPP_Entity] , %Entity%)\nMEMBERSET [d/PCycle] = \"#\"\nMEMBERSET [d/PPP_Currency] = (\"USD\")\nMEMBERSET [d/PPP_EntryNr] = (\"1001\")\nMEMBERSET [d/Date] = PREVIOUS(3,\"YEAR\",%CY%) TO %CY%\nMEMBERSET [d/Measures] = (\"CLO_GC\")\n\nDELETE()\n",
   "memberFilter": {},
   "isVisualPanel": false,
   "scriptReferences": {
    "referenceCubes": [],
    "usedParameters": [
     "Entity",
     "CY"
    ]
   },
   "isConvertedOnce": false,
   "isTextScriptChanged": true
  },
  {
   "id": "26077120-9916-4837-3105-831681780003",
   "name": "Step 04",
   "description": "Move assumptions from central area to entity from CY+1 onward",
   "stepType": "SCRIPT",
   "panelType": "TEXTUAL",
   "scriptContent": "CONFIG.TIME_HIERARCHY = CALENDARYEAR\nCONFIG.FLIPPING_SIGN_ACCORDING_ACCTYPE = OFF\nCONFIG.GENERATE_UNBOOKED_DATA = ON\n\nMEMBERSET [d/PPP_Account] = (\"FIN06_02_01\",\"FIN06_02_02\")\nMEMBERSET [d/PPP_Entity] = BASEMEMBER([d/PPP_Entity] , %Entity%)\nMEMBERSET [d/PCycle] = \"#\"\nMEMBERSET [d/PPP_Currency] = (\"#\",\"USD\")\nMEMBERSET [d/PPP_EntryNr] = (\"#\",\"1001\")\nMEMBERSET [d/Date] = NEXT(1,\"YEAR\",%CY%) TO NEXT(5,\"YEAR\",%CY%)\nMEMBERSET [d/Measures] = (\"CLO_GC\",\"RPT_METRCS\")\n\nDATA([d/Measures]=\"CLO_GC\",[d/PPP_Currency]=\"USD\",[d/PPP_EntryNr]=\"1001\") =\n\t\tRESULTLOOKUP([d/Measures]=\"RPT_METRCS\",[d/PPP_Entity] = \"#\",[d/PPP_EntryNr]=\"#\",[d/PPP_Currency]=\"#\")\n\n",
   "memberFilter": {},
   "isVisualPanel": false,
   "scriptReferences": {
    "referenceCubes": [],
    "usedParameters": [
     "Entity",
     "CY"
    ]
   },
   "isConvertedOnce": false,
